# Husky pre-commit — FAST + FAIL-SAFE by design.
#
# Emergent "Save to GitHub" runs `git commit` under the hood, so anything slow or
# fragile here makes the commit silently never happen. Rules:
#   * total budget: a few seconds, hard `timeout` on every step
#   * the ONLY blocking check is the secrets guard (GitHub push protection would
#     reject the push anyway, so failing early with a clear message is strictly better)
#   * everything else is warn-only
#   * NEVER run tsc / yarn install here — TypeScript gating lives in CI
#     (.github/workflows/preflight.yml) and `yarn preflight`
#   * missing node / a crashed guard script must never block a commit
# Bypass: `git commit --no-verify` or HUSKY=0.

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] node not on PATH — guards skipped (CI preflight still runs)."
  exit 0
fi

with_timeout() {
  if command -v timeout >/dev/null 2>&1; then timeout "$@"; else shift; "$@"; fi
}

# 1. Secrets guard — BLOCKING only on a confirmed hit (exit 2). Any other failure
#    (timeout 124, crash 1, missing file 127) is reported but lets the commit through.
set +e
with_timeout 15 node scripts/check-secrets.mjs
rc=$?
set -e
if [ "$rc" -eq 2 ]; then
  exit 1
fi
if [ "$rc" -ne 0 ]; then
  echo "[pre-commit] secrets guard did not finish cleanly (rc=$rc) — commit allowed."
fi

# 2. Warn-only guards (never block).
with_timeout 10 node scripts/check-contrast.mjs --hook || true
with_timeout 10 node backend/scripts/check-email-dark-mode.mjs --hook || echo "[pre-commit] email dark-mode guard reported findings above — commit allowed (fix before deploy)."

echo "[pre-commit] OK. TypeScript is type-checked in CI (preflight.yml) or via \`yarn preflight\`."
exit 0
