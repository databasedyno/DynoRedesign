    { "name": "Transactions", "short_name": "Transactions", "url": "/transactions?source=pwa", "icons": [{ "src": "/pwa-192.png?v=7", "sizes": "192x192" }] },
    { "name": "Payout addresses", "short_name": "Wallet", "url": "/wallet?source=pwa", "icons": [{ "src": "/pwa-192.png?v=7", "sizes": "192x192" }] }
